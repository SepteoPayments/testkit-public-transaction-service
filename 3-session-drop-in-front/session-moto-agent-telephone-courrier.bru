meta {
  name: Session — MOTO invalide (refus 422)
  type: http
  seq: 6
}
post {
  url: {{base_url}}/api/public/v1/sessions
  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
  Idempotency-Key: {{idemKey}}
}
auth:bearer {
  token: {{access_token}}
}
body:json {
  {
    "amount": { "value": {{amount_value}}, "currency": "{{currency}}" },
    "reference": "test-session-moto-invalide",
    "publicStoreId": "{{publicStoreId}}",
    "returnUrl": "https://exemple.fr/retour",
    "shopperCountryCode": "FR",
    "capture": { "mode": "IMMEDIATE" },
    "moto": true,
    "tokenization": null,
    "preAuth": false
  }
}
docs {
  Cas négatif #3049. MOTO = tokenisation d'une carte uniquement : un MOTO ne doit jamais être
  capturable. L'API refuse donc toute session MOTO qui n'est pas une autorisation à 0, en capture
  MANUAL, avec une instruction de tokenisation. Ici amount non nul + capture IMMEDIATE + sans
  tokenisation → refus 422 MOTO_NOT_CAPTURABLE. Pour un MOTO valide, voir « Token via auth à 0 (MOTO) ».
}
script:post-response {
  test('422 refusé', function () { expect(res.getStatus()).to.equal(422); });
  test('code MOTO_NOT_CAPTURABLE', function () {
    var b = res.getBody();
    expect(b && b.code).to.equal('MOTO_NOT_CAPTURABLE');
  });
}
