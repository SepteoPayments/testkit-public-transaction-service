meta {
  name: Session — Enrichissement shopper / risque (#3043)
  type: http
  seq: 8
}
post {
  url: {{base_url}}/api/public/v1/sessions
  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
  Idempotency-Key: {{idemKey}}
}
auth:bearer {
  token: {{access_token}}
}
body:json {
  {
    "amount": { "value": 9000, "currency": "{{currency}}" },
    "reference": "test-session-enrichissement",
    "publicStoreId": "{{publicStoreId}}",
    "returnUrl": "https://exemple.fr/retour",
    "shopperCountryCode": "FR",
    "capture": { "mode": "IMMEDIATE" },
    "shopperEnrichment": {
      "shopperName": { "firstName": "Marc", "lastName": "Dupont" },
      "shopperEmail": "marc.dupont@exemple.fr",
      "telephoneNumber": "+33612345678",
      "shopperIp": "88.120.10.20",
      "shopperLocale": "fr-FR",
      "shopperStatement": "SEPTEO RESA",
      "deliveryAddress": {
        "street": "10 rue du Fnu",
        "houseNumberOrName": "10",
        "city": "Nice",
        "postalCode": "06000",
        "country": "FR"
      },
      "lodging": {
        "checkInDate": "2026-08-25",
        "checkOutDate": "2026-08-28",
        "numberOfNights": 3,
        "roomRate": { "value": 9000, "currency": "{{currency}}" }
      },
      "merchantRiskIndicator": { "deliveryAddressIndicator": "SHIP_TO_BILLING_ADDRESS" },
      "accountInfo": { "accountAgeIndicator": "MORE_THAN_60_DAYS", "deliveryAddressUsageIndicator": "MORE_THAN_60_DAYS" }
    }
  }
}
docs {
  Ouvre une session avec l'enrichissement shopper/risque (#3043, lot 1) : nom, e-mail, téléphone,
  IP, locale, statement, adresse de livraison, données de séjour (lodging) et indicateurs de risque
  (3DS2 / Safe'R CB). Tous ces champs sont optionnels ; ils améliorent le taux d'autorisation,
  le score de risque et l'exemption 3DS2. Mappés côté back vers Adyen Checkout ; lodging passe par
  l'enhanced scheme data (additionalData lodging.*), l'ancienneté de compte par accountInfo.
}
script:post-response {
  test('200 CREATED', function () { expect(res.getStatus()).to.equal(200); });
  var b = res.getBody();
  if (b && b.clientSession) {
    bru.setVar('clientSession', b.clientSession);
    if (b.publicSessionId) bru.setVar('publicSessionId', b.publicSessionId);
  } else { console.log('Pas de clientSession :', JSON.stringify(b)); }
}
