# Copie ce fichier en .env (gitignore) et colle les cles privees des clients de test.
# PEM multi-ligne : garde les \n litteraux OU des vraies nouvelles lignes entre guillemets.
# Chaque environnement Bruno nomme sa variable via `private_key_var` :
#   Sandbox-Marc-Spa et Qualification-Marc-Spa -> PRIVATE_KEY_PEM (meme client, bases copiees de la sandbox)
#   Test                                       -> PRIVATE_KEY_PEM_TEST (autre client, autre cle)
PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...colle ici...\n-----END PRIVATE KEY-----\n"
PRIVATE_KEY_PEM_TEST="-----BEGIN PRIVATE KEY-----\n...colle ici...\n-----END PRIVATE KEY-----\n"

# Secret du client Keycloak (SSO legacy) utilise par le dossier 7, pour les endpoints v1.
# Back-office > store > onglet "API Key public" > SSO Application secret (bouton oeil).
SSO_CLIENT_SECRET="...colle ici..."
