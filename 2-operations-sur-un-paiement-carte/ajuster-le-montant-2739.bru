meta {
  name: Ajuster le montant (#2739)
  type: http
  seq: 3
}
post {
  url: {{base_url}}/api/public/v1/payments/{{pspReference}}/amount
  body: json
  auth: bearer
}
headers {
  Content-Type: application/json
  Idempotency-Key: {{idemKey}}
}
auth:bearer {
  token: {{access_token}}
}
body:json {
  {
    "amount": { "value": 1500, "currency": "{{currency}}" },
    "publicStoreId": "{{publicStoreId}}"
  }
}
script:post-response {
  test('Reponse acceptee (2xx)', function () {
    expect([200,201,202,204]).to.include(res.getStatus());
  });
  try { var b = res.getBody(); if (b && b.status) console.log('status:', b.status); } catch (e) {}
}
