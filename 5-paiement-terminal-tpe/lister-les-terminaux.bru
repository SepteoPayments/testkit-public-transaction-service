meta {
  name: Lister les terminaux
  type: http
  seq: 1
}
get {
  url: {{base_url}}/api/public/v1/stores/{{publicStoreId}}/terminals
  body: none
  auth: bearer
}
auth:bearer {
  token: {{access_token}}
}
script:post-response {
  test('OK (200)', function () { expect(res.getStatus()).to.equal(200); });
  var b = res.getBody();
  if (b && b.terminals && b.terminals[0]) { bru.setVar('deviceId', b.terminals[0].deviceId); console.log('deviceId stocke :', b.terminals[0].deviceId); }
}
